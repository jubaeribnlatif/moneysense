{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#ffffff" },
      "foreground": { "$value": "#151916" },
      "border": { "$value": "#c8cfcb" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0a0a0a" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0a0a0a" },
      "primary": {
        "$value": "#171717",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#fafafa" },
      "secondary": { "$value": "#e3e8e5" },
      "secondaryForeground": { "$value": "#171717" },
      "muted": { "$value": "#f0f3f1" },
      "mutedForeground": { "$value": "#59625b" },
      "accent": { "$value": "#19906d", "$description": "Signature green sampled from the supplied Money Sense logo; use in focused accents, selected states, and key actions." },
      "accentForeground": { "$value": "#03150f" },
      "destructive": { "$value": "#b42e35" },
      "destructiveForeground": { "$value": "#fafafa" },
      "input": { "$value": "#778379" },
      "ring": { "$value": "#19906d" },
      "chart1": { "$value": "#286b3f" },
      "chart2": { "$value": "#397b88" },
      "chart3": { "$value": "#8c6222" },
      "chart4": { "$value": "#756496" },
      "chart5": { "$value": "#b45b48" },
      "sidebar": { "$value": "#fafafa" },
      "sidebarForeground": { "$value": "#404040" },
      "sidebarBorder": { "$value": "#e5e5e5" },
      "sidebarPrimary": { "$value": "#171717" },
      "sidebarPrimaryForeground": { "$value": "#fafafa" },
      "sidebarAccent": { "$value": "#e3e8e5" },
      "sidebarAccentForeground": { "$value": "#171717" },
      "sidebarRing": { "$value": "#171717" }
    },
    "dark": {
      "background": { "$value": "#0a0a0a" },
      "foreground": { "$value": "#fafafa" },
      "border": { "$value": "#262626" },
      "card": { "$value": "#0a0a0a" },
      "cardForeground": { "$value": "#fafafa" },
      "popover": { "$value": "#0a0a0a" },
      "popoverForeground": { "$value": "#fafafa" },
      "primary": { "$value": "#fafafa" },
      "primaryForeground": { "$value": "#171717" },
      "secondary": { "$value": "#262626" },
      "secondaryForeground": { "$value": "#fafafa" },
      "muted": { "$value": "#262626" },
      "mutedForeground": { "$value": "#b0b9b2" },
      "accent": { "$value": "#19906d" },
      "accentForeground": { "$value": "#03150f" },
      "destructive": { "$value": "#7f1d1d" },
      "destructiveForeground": { "$value": "#fafafa" },
      "input": { "$value": "#78877b" },
      "ring": { "$value": "#19906d" },
      "chart1": { "$value": "#a5d98b" },
      "chart2": { "$value": "#83c4d0" },
      "chart3": { "$value": "#dfb86f" },
      "chart4": { "$value": "#bba6dc" },
      "chart5": { "$value": "#e8a08b" },
      "sidebar": { "$value": "#171717" },
      "sidebarForeground": { "$value": "#f5f5f5" },
      "sidebarBorder": { "$value": "#262626" },
      "sidebarPrimary": { "$value": "#19906d" },
      "sidebarPrimaryForeground": { "$value": "#03150f" },
      "sidebarAccent": { "$value": "#262626" },
      "sidebarAccentForeground": { "$value": "#f5f5f5" },
      "sidebarRing": { "$value": "#d4d4d4" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Instrument Serif", "Georgia", "serif"], "$description": "Temporary open-source editorial display substitute. Replace with licensed Denton Condensed when supplied." },
      "mono": { "$value": ["Space Grotesk", "sans-serif"], "$description": "Modern geometric utility face requested for compact figures and labels. Use tabular-nums for aligned numerals; this is not a monospaced font." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
